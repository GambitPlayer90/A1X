{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1X sealed run plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"enum": ["a1x.runtime/v1", "a1x.runtime/v2"]},
    "kind": {"const": "run-plan"},
    "id": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"},
    "created_at": {"type": "string"},
    "hypothesis_id": {"type": "string", "pattern": "^HYP-[0-9]{4,}$"},
    "run_class": {"enum": ["candidate", "control", "repair", "fuzz", "solve", "recon"]},
    "cwd": {"type": "object", "required": ["anchor", "path"]},
    "argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_output_bytes": {"type": "integer", "minimum": 1},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "property": {"type": "string"},
    "support_prediction": {"type": "string"},
    "refute_prediction": {"type": "string"},
    "success_regex": {"type": ["string", "null"]},
    "pass_env": {"type": "array", "items": {"type": "string"}},
    "inherit_env": {"type": "array", "items": {"type": "string"}},
    "fork_id": {"type": ["string", "null"]},
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chain_id": {"type": ["integer", "null"]},
        "block_number": {"type": ["integer", "null"]}
      },
      "required": ["chain_id", "block_number"]
    },
    "control_for_run": {"type": ["string", "null"], "pattern": "^RUN-[0-9]{4,}$"},
    "control_contract": {
      "type": ["object", "null"],
      "properties": {
        "support_run": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"},
        "claim": {"type": "string"},
        "changed_argv": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}}
      },
      "required": ["support_run", "claim", "changed_argv"]
    },
    "extension_contract": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^CAND-[0-9]{4,}$"},
        "parent_run": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"},
        "parent_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prefix": {"type": "object"},
        "execution_identity": {"type": "object"}
      },
      "required": ["candidate_id", "parent_run", "parent_plan_sha256", "parent_receipt_sha256", "prefix", "execution_identity"]
    },
    "source_commit": {"type": ["string", "null"]},
    "network_isolation": {"type": "object"}
  },
  "required": ["schema", "kind", "id", "created_at", "hypothesis_id", "run_class", "cwd", "argv_template", "timeout_seconds", "max_output_bytes", "inputs", "property", "support_prediction", "refute_prediction", "success_regex", "pass_env", "inherit_env", "fork_id", "execution_identity", "control_for_run", "control_contract", "extension_contract", "source_commit", "network_isolation"]
}
