{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1X adversarial coverage record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"enum": ["a1x.runtime/v1", "a1x.runtime/v2"]},
    "kind": {"const": "coverage"},
    "family": {"enum": ["value", "authority", "lifecycle", "numeric", "composition"]},
    "status": {"enum": ["challenged", "refuted", "not-applicable"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-ref.schema.json"}},
    "limitations": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "required": ["schema", "kind", "family", "status", "evidence_refs", "limitations", "updated_at"]
}
