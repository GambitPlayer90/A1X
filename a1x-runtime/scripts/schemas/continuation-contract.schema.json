{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1X executable continuation contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "parent_run": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"},
    "parent_handoff": {"type": ["string", "null"]},
    "lineage_id": {"type": "string", "minLength": 1},
    "closure_mode": {"enum": ["witness", "reachability"]},
    "execution_topology": {"enum": ["atomic", "nested-atomic", "multi-transaction", "temporal", "multi-actor"]},
    "checkpoint": {"type": "object"},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "transactions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "preserve_assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "selected_prerequisite": {"type": "object"},
    "reachability": {"type": "object"}
  },
  "required": ["parent_run", "parent_handoff", "lineage_id", "closure_mode", "execution_topology", "checkpoint", "actors", "transactions", "assertions", "preserve_assertions", "selected_prerequisite", "reachability"]
}
